rules_version = '2';

// Starts by DENYING EVERYTHING (the kit's firebase/firestore.rules.example).
// TODO(task 9): a TEMPORARY rule for signed-in users, until task 11.
// TODO(task 11): your own rules, proven by rules-tests/ in the emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
